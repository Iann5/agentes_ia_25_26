### -------------------------------------
### VARIABLES
### -------------------------------------

@baseUrl = http://localhost
@port = 3000
@apiUrl = {{baseUrl}}:{{port}}/api
@contentType = application/json

### -------------------------------------
### HEALTH CHECK
### -------------------------------------
GET {{apiUrl}}/health HTTP/1.1

### -------------------------------------
### CREATE TRANSLATION
### -------------------------------------
POST {{apiUrl}}/translate HTTP/1.1
Content-Type: {{contentType}}

{
"text": "Hola mundo",
"sourceLang": "es",
"targetLang": "en"
}

### -------------------------------------
### READ - All translations
### -------------------------------------
GET {{apiUrl}}/translations HTTP/1.1

### -------------------------------------
### READ - Filter by sourceLang
### -------------------------------------
GET {{apiUrl}}/translations?sourceLang=es HTTP/1.1

### -------------------------------------
### READ - Filter by targetLang
### -------------------------------------
GET {{apiUrl}}/translations?targetLang=en HTTP/1.1

### -------------------------------------
### READ - Translation by ID
### -------------------------------------
GET {{apiUrl}}/translations/97 HTTP/1.1

### -------------------------------------
### DELETE - Translation by ID
### -------------------------------------
DELETE {{apiUrl}}/translations/97 HTTP/1.1

### -------------------------------------
### DELETE - All translations
### -------------------------------------
DELETE {{apiUrl}}/translations HTTP/1.1

### -------------------------------------
### GET - Available languages
### -------------------------------------
GET {{apiUrl}}/languages HTTP/1.1
